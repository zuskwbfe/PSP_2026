				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"client\": \"Барбершоп «Бритва»\",\n  \"service\": \"Настройка Wi-Fi\",\n  \"manager\": \"Смирнова О.А.\",\n  \"executor\": \"Петров И.В.\",\n  \"courier\": \"—\",\n  \"status\": \"Новая\",\n  \"priority\": 2,\n  \"cost\": 1800,\n  \"desc\": \"Настроить роутер и гостевую сеть.\",\n  \"equipment\": \"Роутер TP-Link\"\n}"
				},
				"url": {
					"raw": "http://localhost:3000/tickets",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["tickets"]
				},
				"description": "Создание новой заявки. ID генерируется автоматически. Обязательные поля: client, service, manager."
			},
			"response": []
		},
		{
