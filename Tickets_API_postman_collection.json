				"body": {
					"mode": "raw",
					"raw": "{\n  \"client\": \"Только клиент\"\n}"
				},
				"url": {
					"raw": "http://localhost:3000/tickets",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["tickets"]
				},
				"description": "Проверка валидации — создание без обязательных полей должно вернуть 400 Bad Request"
