					"raw": "http://localhost:3000/tickets/1",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["tickets", "1"]
				},
				"description": "Частичное обновление заявки. Можно передать только изменяемые поля."
			},
			"response": []
		},
